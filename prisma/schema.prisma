generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  displayName     String
  timezone        String   @default("UTC")
  instrument      String   @default("NQ")
  anthropicApiKey String?
  traderProfile   String   @default("")
  role            String   @default("user") // "user" | "admin" | "creator"
  plan            String   @default("trial") // "trial" | "monthly" | "lifetime" | "expired"
  emailVerified   Boolean  @default(false)
  trialEndsAt     DateTime?
  trialReminderSentAt DateTime?
  referredByCode  String?
  createdAt       DateTime @default(now())

  whopUserId       String?  @unique
  whopMembershipId String?

  aiPeriodStart  DateTime?
  aiPeriodEnd    DateTime?
  aiMessagesUsed Int       @default(0)

  trades           Trade[]
  coachMessages    CoachMessage[]
  sentRequests     FriendLink[]   @relation("Requester")
  receivedRequests FriendLink[]   @relation("Receiver")
  creatorCode      CreatorCode?
  referral         Referral?
  savedTagOptions  SavedTagOption[]
  reactionsGiven    JournalReaction[] @relation("ReactionFrom")
  reactionsReceived JournalReaction[] @relation("ReactionTo")
  subscriptions     Subscription[]
  payments          Payment[]
}

model JournalReaction {
  id         String   @id @default(cuid())
  fromUserId String
  from       User     @relation("ReactionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User     @relation("ReactionTo", fields: [toUserId], references: [id], onDelete: Cascade)
  dateKey    String
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId, dateKey])
  @@index([toUserId, seen])
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  result      String
  direction   String
  htfBias     String
  instrument  String   @default("")
  timeFrame   String   @default("")
  entryTime   String   @default("")
  exitTime    String   @default("")
  riskPercent Float    @default(0)
  rulesFollowed Boolean @default(true)
  rr          String   @default("")
  pnl         Float    @default(0)

  drawDirectionTags String @default("[]")
  setupTags         String @default("[]")
  emotionTags       String @default("[]")
  newsTags          String @default("[]")

  whatOthersDid   String @default("")
  notes           String @default("")
  whatWouldYouDo  String @default("")
  chartImageUrl   String @default("")

  hiddenFields String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model EconomicEvent {
  id        String   @id @default(cuid())
  date      String
  time      String   @default("")
  currency  String
  impact    String
  title     String
  createdAt DateTime @default(now())

  @@unique([date, time, currency, title])
}

model FriendLink {
  id          String   @id @default(cuid())
  requesterId String
  receiverId  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model SavedTagOption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, field, value])
  @@index([userId, field])
}

model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// General (non-affiliate) discount codes, e.g. the launch promo. Backed by a real
// Whop promo code so the discount actually applies to the charge.
model DiscountCode {
  id              String   @id @default(cuid())
  code            String   @unique
  percentOff      Int?
  amountOffCents  Int?
  active          Boolean  @default(true)
  maxRedemptions  Int?
  timesRedeemed   Int      @default(0)
  whopPromoCodeId String?
  startsAt        DateTime?
  endsAt          DateTime?
  planKeys        String   @default("[]") // JSON array, e.g. ["monthly","lifetime"]
  createdAt       DateTime @default(now())
}

model CreatorCode {
  id                String   @id @default(cuid())
  code              String   @unique
  creatorUserId     String   @unique
  creator           User     @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  commissionPercent Int      @default(20) // legacy default, superseded by CreatorPlanRule per plan
  active            Boolean  @default(true)
  whopAffiliateId   String?
  whopAffiliateCode String?
  createdAt         DateTime @default(now())

  referrals Referral[]
  planRules CreatorPlanRule[]
}

// Per-plan discount/commission configuration for a creator code — lets one visible
// code (e.g. JOHN25) carry different economics for Monthly vs. Lifetime.
model CreatorPlanRule {
  id                 String      @id @default(cuid())
  creatorCodeId      String
  creatorCode        CreatorCode @relation(fields: [creatorCodeId], references: [id], onDelete: Cascade)
  planKey            String // "monthly" | "lifetime"
  whopPromoCodeId    String?
  whopPromoCode      String // literal code string, kept in sync with the visible creator code
  discountType       String      @default("percent") // "percent" | "flat"
  discountValue      Float
  commissionType      String     @default("percent") // "percent" | "flat"
  commissionValue     Float
  commissionDuration String      @default("first_payment") // "first_payment" | "all_payments"
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())

  @@unique([creatorCodeId, planKey])
}

model Referral {
  id             String      @id @default(cuid())
  creatorCodeId  String
  creatorCode    CreatorCode @relation(fields: [creatorCodeId], references: [id], onDelete: Cascade)
  referredUserId String      @unique
  referredUser   User        @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
  firstTouchAt   DateTime    @default(now())
  convertedAt    DateTime?
  status         String      @default("attributed") // "attributed" | "converted"
  createdAt      DateTime    @default(now())
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String    @default("whop")
  whopMembershipId   String    @unique
  whopPlanId         String
  status             String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String   @default("whop")
  whopPaymentId String   @unique
  amount        Float
  currency      String   @default("usd")
  planKey       String
  status        String
  creatorCodeId String?
  promoCode     String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("whop")
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}
